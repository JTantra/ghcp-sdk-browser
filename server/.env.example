# GitHub PAT with Copilot entitlement. Required.
GITHUB_TOKEN=ghp_xxx

# Model for the master orchestrator.
COPILOT_MODEL=claude-sonnet-4.6

# Mock ops-data MCP server. Swap for a Foundry Toolbox consumer endpoint:
#   https://<account>.services.ai.azure.com/api/projects/<project>/toolboxes/<name>/mcp?api-version=v1
OPS_MCP_URL=http://127.0.0.1:8089/mcp

# Injected by Foundry at runtime; set locally only if you want traces.
# APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=...

PORT=8088
