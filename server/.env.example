# GitHub PAT with Copilot entitlement. Required.
GITHUB_TOKEN=ghp_xxx

# Model for the master orchestrator.
COPILOT_MODEL=claude-sonnet-5

# Ops tools (ops_node_capacity, ops_carrier_policy) run in-process inside the
# container -- see server/app/ops_tools.py. No MCP server or URL is needed.

# Injected by Foundry at runtime; set locally only if you want traces.
# APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=...

PORT=8088
