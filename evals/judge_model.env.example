# Copy to .env and adjust. Auth is AAD (az login) throughout -- subscription
# policy forces disableLocalAuth=true on Cognitive Services, so there is no
# API-key path for the judge model.

# Foundry project (data plane). Eval runs upload here and appear under
# the portal's Evaluations blade.
AZURE_AI_PROJECT_ENDPOINT="https://jtantra-test-foundry2.services.ai.azure.com/api/projects/jtantra-test-foundry2"

# Agent under test. run_eval.py appends /endpoint/protocols/invocations.
AGENT_BASE_URL="https://jtantra-test-foundry2.services.ai.azure.com/api/projects/jtantra-test-foundry2/agents/ghcp-sdk-browser"

# Judge model -- MUST NOT be the model under test (agent runs claude-sonnet-5
# via GitHub Copilot, so any Foundry-hosted OpenAI deployment is independent).
# Verified deployed in this project: gpt-4.1, gpt-4o, o4-mini, gpt-5.4.
JUDGE_ENDPOINT="https://jtantra-test-foundry2.services.ai.azure.com"
JUDGE_MODEL_DEPLOYMENT="gpt-4.1"
JUDGE_MODEL_API_VERSION="2024-10-21"
